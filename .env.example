# Bilim Arena Race — переменные окружения
#
# Скопируйте этот файл в .env.local и заполните значения:
#   cp .env.example .env.local
# .env.local исключён из Git. Реальные ключи НИКОГДА не коммитятся.
#
# Используйте ОТДЕЛЬНЫЙ Supabase-проект для Bilim Arena Race —
# не production-базу основного сайта Bilim Arena.
# Значения: Supabase Dashboard → Project Settings → API Keys / Data API.

# URL Supabase-проекта, например https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Попадает в браузер — это нормально:
# доступ к данным ограничивают политики Row Level Security, а не секретность ключа.
# Legacy anon key тоже подходит для этой переменной.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — на Этапе 0 НЕ используется.
# Понадобится только доверенному серверному коду (Route Handlers / Server Actions),
# если Postgres-функций с RLS окажется недостаточно.
# Никогда не добавляйте к нему префикс NEXT_PUBLIC_ и не используйте в клиентском коде.
# SUPABASE_SECRET_KEY=
